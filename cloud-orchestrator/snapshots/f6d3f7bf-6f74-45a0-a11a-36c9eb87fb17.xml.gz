hecked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[320,464][731,552]" drawing-order="2" hint="" /><node index="2" text="Building and scaling online businesses on Linkedin | Forbes 30u30 | 3x Founder | Helped 3,000+ people build their personal brand online" resource-id="com.linkedin.android:id/video_actor_description" class="android.widget.TextView" package="com.linkedin.android" content-desc="Building and scaling online businesses on Linkedin | Forbes 30u30 | 3x Founder | Helped 3,000+ people build their personal brand online" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[320,560][1344,634]" drawing-order="4" hint="" /><node index="3" text="Follow" resource-id="com.linkedin.android:id/video_actor_action_button" class="android.widget.Button" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[779,412][1007,604]" drawing-order="3" hint="" /><node index="4" text="1d •   " resource-id="com.linkedin.android:id/video_actor_sub_description" class="android.widget.TextView" package="com.linkedin.android" content-desc="1 day ago • Visible to anyone on or off LinkedIn" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[320,642][509,716]" drawing-order="5" hint="" /></node><node index="1" text="" resource-id="" class="android.view.ViewGroup" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,2179][1392,2384]" drawing-order="3" hint=""><node index="0" text="I have 353,701 followers on LinkedIn. &#10;&#10;This is the AI system I use to write viral content every single week (while growing my businesses). &#10;&#10;Let me show you how it works in 3 steps: &#10;&#10;If you want to be in the top 1% in your niche, virality engineering is exactly how you do this. &#10;&#10;1. Data collection: understand exactly what topics, formats and angles work across LinkedIn. &#10;&#10;2. Content engineering: based on the data, and proven patterns engineer your hooks and writing to match the content that outperformed for other LinkedIn creators.&#10;&#10;3. Authority building: get crystal clear on what topic your audience is interested in the most and use it as the leading keyword(s) in your hooks and graphics. &#10;&#10;This is the process I've used over the last 4 years.&#10;The same process that's made me $3M+ on Linkedin. &#10;&#10;Clients used to pay me thousands to do this for them, but I don't run a ghostwriting agency anymore... &#10;&#10;So I put the entire process inside an AI tool instead. &#10;&#10;Today Kleo follows that exact same system. &#10;&#10;It learns everything about you.&#10;It builds you a personalised strategy.&#10;It gives you a 30-day content plan.&#10;&#10;All in minutes rather than weeks. &#10;&#10;This system works. Thousands of entrepreneurs and creators are going viral with Kleo today. &#10;&#10;If you want to be our next viral personal brand...&#10;Try kleo here: https://kleo.so/offer&#10;&#10;New yearly users get access to our $2500 coaching programme + weekly calls and resources. &#10;&#10;You in?&#10;&#10;Repost ♻️ if this was valuable to you&#10;&#10;PS: I used to do this process manually for years, I used to spend 2 hours a day writing my own content... what about you? Curious to know, maybe I was too slow... &#10;" resource-id="com.linkedin.android:id/commentary" class="android.widget.TextView" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,2179][992,2384]" drawing-order="1" hint="" /><node NAF="true" index="1" text="" resource-id="com.linkedin.android:id/caption_button" class="android.widget.Button" package="com.linkedin.android" content-desc="" checkable="false" checked="true" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[992,2192][1184,2384]" drawing-order="3" hint="" /><node index="2" text="" resource-id="com.linkedin.android:id/sound_button" class="android.widget.Button" package="com.linkedin.android" content-desc="Unmute video" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1184,2192][1376,2384]" drawing-order="4" hint="" /></node></node><node index="2" text="" resource-id="com.linkedin.android:id/large_video_top_gradient" class="android.view.View" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,400][1392,920]" drawing-order="2" hint="" /><node index="3" text="" resource-id="com.linkedin.android:id/large_video_bottom_gradient" class="android.view.View" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,1896][1392,2416]" drawing-order="3" hint="" /></node><node index="1" text="" resource-id="com.linkedin.android:id/feed_conversations_social_counts_co