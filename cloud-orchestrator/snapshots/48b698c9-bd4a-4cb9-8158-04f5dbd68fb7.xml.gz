"false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[272,400][1018,633]" drawing-order="2" hint=""><node index="0" text="Julius Nylund • 3rd+" resource-id="com.linkedin.android:id/feed_actor_name" class="android.widget.Button" package="com.linkedin.android" content-desc="Julius Nylund, 3rd+" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[272,400][866,485]" drawing-order="1" hint="" /><node index="1" text="Helping founders and …" resource-id="com.linkedin.android:id/feed_actor_headline" class="android.widget.TextView" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[272,485][844,559]" drawing-order="2" hint="" /><node index="2" text="1d •   " resource-id="com.linkedin.android:id/feed_actor_secondary_headline" class="android.widget.TextView" package="com.linkedin.android" content-desc="1 day ago • Visible to anyone on or off LinkedIn" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[272,559][445,633]" drawing-order="4" hint="" /></node><node index="2" text="Follow" resource-id="com.linkedin.android:id/feed_actor_action_button" class="android.widget.Button" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1050,352][1440,545]" drawing-order="3" hint="" /></node><node index="1" text="BYE BYE manual cold outreach… &#10;&#10;Claude + LinkedIn can now handle almost everything. ↓&#10;&#10;Most sales teams still waste their time on repetitive outbound tasks:&#10;&#10;→ Searching for relevant prospects&#10;→ Researching accounts one by one&#10;→ Sending the same generic sequences&#10;→ Contacting leads with no buying intent&#10;→ Manually managing every follow-up&#10;&#10;But the best sales teams are already moving in a different direction.&#10;&#10;They’re building AI-powered outbound systems.&#10;&#10;And Anthropic just made that much easier with Claude Code for Sales.&#10;&#10;It can automate nearly the entire outbound process:&#10;&#10;→ Identify prospects with genuine buying signals&#10;→ Research each person and company automatically&#10;→ Determine why they could be ready to buy&#10;→ Create personalized outreach at scale&#10;→ Sort and respond to incoming replies&#10;→ Continue conversations without manual follow-ups&#10;→ Qualify leads based on their responses&#10;→ Schedule meetings directly into your calendar&#10;&#10;This isn’t about adding another tool to your sales stack.&#10;&#10;It’s about letting AI handle the repetitive work, so that your sales team can spend more time speaking with qualified prospects and closing deals.&#10;&#10;The results within 30 days:&#10;&#10;- 42% reply rate.&#10;- 3–5 meetings booked every day.&#10;- $1.2M in pipeline created.&#10;&#10;I packaged the complete Claude + LinkedIn system we used so you can implement it yourself.&#10;&#10;FREE ACCESS BELOW. ↓" resource-id="com.linkedin.android:id/feed_render_item_text" class="android.widget.TextView" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,665][1440,2856]" drawing-order="2" hint="" /></node></node></node></node><node index="2" text="" resource-id="com.linkedin.android:id/update_detail_comment_bar" class="and