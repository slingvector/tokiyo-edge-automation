"false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[272,400][1018,633]" drawing-order="2" hint=""><node index="0" text="Sakshi Pathak • 2nd" resource-id="com.linkedin.android:id/feed_actor_name" class="android.widget.Button" package="com.linkedin.android" content-desc="Sakshi Pathak, 2nd" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[272,400][857,485]" drawing-order="1" hint="" /><node index="1" text="Founder-led content &amp; …" resource-id="com.linkedin.android:id/feed_actor_headline" class="android.widget.TextView" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[272,485][868,559]" drawing-order="2" hint="" /><node index="2" text="1d •   " resource-id="com.linkedin.android:id/feed_actor_secondary_headline" class="android.widget.TextView" package="com.linkedin.android" content-desc="1 day ago • Visible to anyone on or off LinkedIn" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[272,559][445,633]" drawing-order="4" hint="" /></node><node index="2" text="Follow" resource-id="com.linkedin.android:id/feed_actor_action_button" class="android.widget.Button" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1050,352][1440,545]" drawing-order="3" hint="" /></node><node index="1" text='I got a ₹80,000/month job opportunity without applying for it. Proof that posting on LinkedIn works and gets you more opportunities.&#10;&#10;If you&apos;re on LinkedIn looking for a job, more work, clients or better opportunities, keep reading.&#10;Here&apos;s what happened -&#10;&#10;I had not posted on LinkedIn for almost a week. I was busy and posting somehow slipped, even though building my personal brand is one of my biggest priorities right now.&#10;&#10;Even after not posting anything for week, HR of a well-known brand in my industry reached out to me directly about a Social Media Manager role.&#10;&#10;I didn&apos;t apply, didn&apos;t message their HR. They FOUND me and this isn&apos;t some random small company either. The brand has raised $4M+ in funding, has more than 300,000 active customers, and recently raised another $3M in Series A funding.&#10;&#10;Knowing that someone had found me because of the work I had been putting out on LinkedIn and that&apos;s exactly why I keep talking about personal branding.&#10;&#10;When you consistently post about your work, experiences, opinions and what you actually know, people start knowing what you do before they ever speak to you. I&apos;m attaching the screenshot of the message below because I don&apos;t want this to sound like another "build your personal brand" post.&#10;&#10;So if you&apos;re looking for a job, trying to get more clients, looking for freelance work don&apos;t use LinkedIn only to apply for them. Use it to get discovered, you never know who&apos;s reading your posts and you definitely don&apos;t know which post will open your next door.&#10;&#10;If you&apos;ve been wanting to build your personal brand on LinkedIn, but don&apos;t know what to post, how to stay consistent or how to actually turn your content into opportunities, I&apos;m now doing 1:1 sessions on topmate.io.&#10;&#10;I&apos;ll leave the Topmate link in the first comment. If you think you could use some help, feel free to book a session with me.&#10;&#10;#LinkedInGrowth #PersonalBranding #LinkedInTips #CareerGrowth #JobSearch #ContentStrategy #PersonalBrand #LinkedInIndia' resource-id="com.linkedin.android:id/feed_render_item_text" class="android.widget.TextView" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,665][1440,2856]" drawing-order="2" hint="" /></node></node></node></node><node index="2" text="" resource-id="com.linkedin.android:id/update_detail_comment_bar" class="android.widget.LinearLayout" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2856][1440,3120]" drawing-order="3" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2856][1440,2860]" drawing-order="1" hint="" /><node index="1" text="" resource-id="com.linkedin.android:id/comment_bar" class="android.view.ViewGroup" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2860][1440,3120]" drawing-order="5" hint=""><node index="0" text="" resource-id="com.linkedin.android:id/comment_bar_actor_switcher" class="android.widget.Button" package="com.linkedin.android" content-desc="Reacting and commenting as ANUJ KUMAR. Select a different profile or page to react or comment as" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,2868][224,3060]" drawing-order="1" hint="" /><node index="1" text="" resource-id="com.linkedin.android:id/comment_bar_actor_switcher_caret" class="android.widget.ImageView" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[144,2980][192,3028]" drawing-order="2" hint="" /><node index="2" text="" resource-id="com.linkedin.android:id/comment_bar_input_box_rounded_corners" class="android.widget.ImageView" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[256,2860][1184,3060]" drawing-order="4" hint="" /><node index="3" text="" resource-id="com.linkedin.android:id/comment_bar_scrollview" class="android.widget.ScrollView" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[256,2860][1184,3060]" drawing-order="3" hint=""><node index="0" text="" resource-id="com.linkedin.android:id/comment_bar_input_box_container" class="android.widget.LinearLayout" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[256,2860][1184,3060]" drawing-order="1" hint=""><node index="1" text="Add a comment…" resource-id="com.linkedin.android:id/comment_bar_edit_text" class="android.widget.EditText" package="com.linkedin.android" content-desc="" checkable="false" checked="false" clickable="true